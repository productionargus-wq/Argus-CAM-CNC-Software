ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Argus CAM 3D Mold Cavity Steep Finishing Benchmark','AP214 Automotive Design'),'2;1');
FILE_NAME('Mold_Steep_Finishing_Sample.step','2026-11-16T05:05:57.689Z',('Argus CAM Engineering'),('Argus Technologies'),'Argus STEP Generator v1.0','Argus Master CAM Web App','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('part definition',#1,'mechanical');
#4=PRODUCT('mold_steep_sample','3D Mold Cavity Steep Sample','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('1.0',$,#4);
#6=PRODUCT_DEFINITION('design',$,#5,#3);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);

/* Cartesian Points */
/* Base Plate (100x80, Y = -20 to -10) */
#10=CARTESIAN_POINT('B1',(-50.0,-20.0,-40.0));
#11=CARTESIAN_POINT('B2',(50.0,-20.0,-40.0));
#12=CARTESIAN_POINT('B3',(50.0,-20.0,40.0));
#13=CARTESIAN_POINT('B4',(-50.0,-20.0,40.0));
#14=CARTESIAN_POINT('B5',(-50.0,-10.0,-40.0));
#15=CARTESIAN_POINT('B6',(50.0,-10.0,-40.0));
#16=CARTESIAN_POINT('B7',(50.0,-10.0,40.0));
#17=CARTESIAN_POINT('B8',(-50.0,-10.0,40.0));

/* Main Deck (90x70, Y = 0) - Shallow 0° */
#30=CARTESIAN_POINT('D1',(-45.0,0.0,-35.0));
#31=CARTESIAN_POINT('D2',(45.0,0.0,-35.0));
#32=CARTESIAN_POINT('D3',(45.0,0.0,35.0));
#33=CARTESIAN_POINT('D4',(-45.0,0.0,35.0));

/* Central Steep Boss Base (70x50, Y = 0) */
#40=CARTESIAN_POINT('S1',(-35.0,0.0,-25.0));
#41=CARTESIAN_POINT('S2',(35.0,0.0,-25.0));
#42=CARTESIAN_POINT('S3',(35.0,0.0,25.0));
#43=CARTESIAN_POINT('S4',(-35.0,0.0,25.0));

/* Steep Boss Top Plateau (30x20, Y = 15) */
#50=CARTESIAN_POINT('T1',(-15.0,15.0,-10.0));
#51=CARTESIAN_POINT('T2',(15.0,15.0,-10.0));
#52=CARTESIAN_POINT('T3',(15.0,15.0,10.0));
#53=CARTESIAN_POINT('T4',(-15.0,15.0,10.0));

/* Steep Cavity Pocket Floor (30x20, Y = -15) - Shallow 0° */
#60=CARTESIAN_POINT('C1',(-15.0,-15.0,-10.0));
#61=CARTESIAN_POINT('C2',(15.0,-15.0,-10.0));
#62=CARTESIAN_POINT('C3',(15.0,-15.0,10.0));
#63=CARTESIAN_POINT('C4',(-15.0,-15.0,10.0));

/* Poly Loops */
#101=POLY_LOOP('BASE_BOTTOM',(#10,#11,#12,#13));
#102=POLY_LOOP('BASE_WALL_FRONT',(#10,#14,#15,#11));
#103=POLY_LOOP('BASE_WALL_RIGHT',(#11,#15,#16,#12));
#104=POLY_LOOP('BASE_WALL_BACK',(#12,#16,#17,#13));
#105=POLY_LOOP('BASE_WALL_LEFT',(#13,#17,#14,#10));

/* Deck Vertical Walls (Y: -10 to 0) - 90° Steep */
#110=POLY_LOOP('DECK_WALL_FRONT',(#14,#30,#31,#15));
#111=POLY_LOOP('DECK_WALL_RIGHT',(#15,#31,#32,#16));
#112=POLY_LOOP('DECK_WALL_BACK',(#16,#32,#33,#17));
#113=POLY_LOOP('DECK_WALL_LEFT',(#17,#33,#30,#14));

/* Deck Floor (0° Shallow) */
#120=POLY_LOOP('DECK_FLOOR_NORTH',(#30,#31,#41,#40));
#121=POLY_LOOP('DECK_FLOOR_EAST',(#31,#32,#42,#41));
#122=POLY_LOOP('DECK_FLOOR_SOUTH',(#32,#33,#43,#42));
#123=POLY_LOOP('DECK_FLOOR_WEST',(#33,#30,#40,#43));

/* Central Boss Flanks (55° to 90° Steep Walls) */
#130=POLY_LOOP('BOSS_STEEP_WALL_NORTH',(#40,#41,#51,#50));
#131=POLY_LOOP('BOSS_STEEP_WALL_EAST',(#41,#42,#52,#51));
#132=POLY_LOOP('BOSS_STEEP_WALL_SOUTH',(#42,#43,#53,#52));
#133=POLY_LOOP('BOSS_STEEP_WALL_WEST',(#43,#40,#50,#53));
#134=POLY_LOOP('BOSS_TOP_PLATEAU',(#50,#51,#52,#53));

/* Cavity Walls (65° Steep Pocket Walls) */
#140=POLY_LOOP('CAV_STEEP_WALL_1',(#50,#51,#61,#60));
#141=POLY_LOOP('CAV_STEEP_WALL_2',(#51,#52,#62,#61));
#142=POLY_LOOP('CAV_STEEP_WALL_3',(#52,#53,#63,#62));
#143=POLY_LOOP('CAV_STEEP_WALL_4',(#53,#50,#60,#63));
#144=POLY_LOOP('CAV_FLOOR_SHALLOW',(#60,#61,#62,#63));

/* Face Outer Bounds */
#201=FACE_OUTER_BOUND('F1',#101,.T.);
#202=FACE_OUTER_BOUND('F2',#102,.T.);
#203=FACE_OUTER_BOUND('F3',#103,.T.);
#204=FACE_OUTER_BOUND('F4',#104,.T.);
#205=FACE_OUTER_BOUND('F5',#105,.T.);

#210=FACE_OUTER_BOUND('F10',#110,.T.);
#211=FACE_OUTER_BOUND('F11',#111,.T.);
#212=FACE_OUTER_BOUND('F12',#112,.T.);
#213=FACE_OUTER_BOUND('F13',#113,.T.);

#220=FACE_OUTER_BOUND('F20',#120,.T.);
#221=FACE_OUTER_BOUND('F21',#121,.T.);
#222=FACE_OUTER_BOUND('F22',#122,.T.);
#223=FACE_OUTER_BOUND('F23',#123,.T.);

#230=FACE_OUTER_BOUND('F30',#130,.T.);
#231=FACE_OUTER_BOUND('F31',#131,.T.);
#232=FACE_OUTER_BOUND('F32',#132,.T.);
#233=FACE_OUTER_BOUND('F33',#133,.T.);
#234=FACE_OUTER_BOUND('F34',#134,.T.);

#240=FACE_OUTER_BOUND('F40',#140,.T.);
#241=FACE_OUTER_BOUND('F41',#141,.T.);
#242=FACE_OUTER_BOUND('F42',#142,.T.);
#243=FACE_OUTER_BOUND('F43',#143,.T.);
#244=FACE_OUTER_BOUND('F44',#144,.T.);

/* Advanced B-Rep Faces */
#301=ADVANCED_FACE('BASE_BOTTOM',(#201),$,.T.);
#302=ADVANCED_FACE('BASE_FRONT',(#202),$,.T.);
#303=ADVANCED_FACE('BASE_RIGHT',(#203),$,.T.);
#304=ADVANCED_FACE('BASE_BACK',(#204),$,.T.);
#305=ADVANCED_FACE('BASE_LEFT',(#205),$,.T.);

#310=ADVANCED_FACE('DECK_WALL_FRONT',(#210),$,.T.);
#311=ADVANCED_FACE('DECK_WALL_RIGHT',(#211),$,.T.);
#312=ADVANCED_FACE('DECK_WALL_BACK',(#212),$,.T.);
#313=ADVANCED_FACE('DECK_WALL_LEFT',(#213),$,.T.);

#320=ADVANCED_FACE('DECK_FLOOR_NORTH',(#220),$,.T.);
#321=ADVANCED_FACE('DECK_FLOOR_EAST',(#221),$,.T.);
#322=ADVANCED_FACE('DECK_FLOOR_SOUTH',(#222),$,.T.);
#323=ADVANCED_FACE('DECK_FLOOR_WEST',(#223),$,.T.);

#330=ADVANCED_FACE('BOSS_STEEP_WALL_NORTH',(#230),$,.T.);
#331=ADVANCED_FACE('BOSS_STEEP_WALL_EAST',(#231),$,.T.);
#332=ADVANCED_FACE('BOSS_STEEP_WALL_SOUTH',(#232),$,.T.);
#333=ADVANCED_FACE('BOSS_STEEP_WALL_WEST',(#233),$,.T.);
#334=ADVANCED_FACE('BOSS_TOP_PLATEAU',(#234),$,.T.);

#340=ADVANCED_FACE('CAV_STEEP_WALL_1',(#240),$,.T.);
#341=ADVANCED_FACE('CAV_STEEP_WALL_2',(#241),$,.T.);
#342=ADVANCED_FACE('CAV_STEEP_WALL_3',(#242),$,.T.);
#343=ADVANCED_FACE('CAV_STEEP_WALL_4',(#243),$,.T.);
#344=ADVANCED_FACE('CAV_FLOOR_SHALLOW',(#244),$,.T.);

/* Closed Shell & Solid B-Rep */
#400=CLOSED_SHELL('MOLD_CAVITY_SHELL',(#301,#302,#303,#304,#305,#310,#311,#312,#313,#320,#321,#322,#323,#330,#331,#332,#333,#334,#340,#341,#342,#343,#344));
#401=MANIFOLD_SOLID_BREP('MOLD_STEEP_SOLID',#400);

ENDSEC;
END-ISO-10303-21;
