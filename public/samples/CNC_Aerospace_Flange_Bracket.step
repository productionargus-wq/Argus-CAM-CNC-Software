ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Argus Master CAM Precision CNC Part','AP214 AUTOMOTIVE_DESIGN','B-Rep Solid Model'),'2;1');
FILE_NAME('CNC_Aerospace_Flange_Bracket.step','2026-11-06T04:32:20.469Z',('Argus CAM Engineering Team'),('Argus Technologies CNC'),'Argus STEP Processor v2.4','Argus Master CAM','Approved');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('part definition',#1,'mechanical');
#4=PRODUCT('CNC_Aerospace_Flange_Bracket','CNC Aerospace Flange Bracket','Prismatic Aerospace Mounting Bracket with Central Pocket',(#3));
#5=PRODUCT_DEFINITION_FORMATION('1.0',$,#4);
#6=PRODUCT_DEFINITION('design',$,#5,#3);
#7=PRODUCT_DEFINITION_SHAPE('','',#6);

/* ==================== 1. GEOMETRIC CARTESIAN POINTS ==================== */
/* Bottom Base Vertices (Z=0 plane) */
#10=CARTESIAN_POINT('V_B1',(-60,0.0,-40));
#11=CARTESIAN_POINT('V_B2',(60,0.0,-40));
#12=CARTESIAN_POINT('V_B3',(60,0.0,40));
#13=CARTESIAN_POINT('V_B4',(-60,0.0,40));

/* Top Deck Outer Vertices (Z=25mm) */
#14=CARTESIAN_POINT('V_T1',(-60,25,-40));
#15=CARTESIAN_POINT('V_T2',(60,25,-40));
#16=CARTESIAN_POINT('V_T3',(60,25,40));
#17=CARTESIAN_POINT('V_T4',(-60,25,40));

/* Central Pocket Top Lip Vertices (Z=25mm) */
#20=CARTESIAN_POINT('P_T1',(-30,25,-20));
#21=CARTESIAN_POINT('P_T2',(30,25,-20));
#22=CARTESIAN_POINT('P_T3',(30,25,20));
#23=CARTESIAN_POINT('P_T4',(-30,25,20));

/* Central Pocket Floor Vertices (Z=13mm) */
#24=CARTESIAN_POINT('P_B1',(-30,13,-20));
#25=CARTESIAN_POINT('P_B2',(30,13,-20));
#26=CARTESIAN_POINT('P_B3',(30,13,20));
#27=CARTESIAN_POINT('P_B4',(-30,13,20));

/* Island Boss in Central Pocket (Z=13mm to 19mm) */
#30=CARTESIAN_POINT('ISL_B1',(-10.0,13,-10.0));
#31=CARTESIAN_POINT('ISL_B2',(10.0,13,-10.0));
#32=CARTESIAN_POINT('ISL_B3',(10.0,13,10.0));
#33=CARTESIAN_POINT('ISL_B4',(-10.0,13,10.0));
#34=CARTESIAN_POINT('ISL_T1',(-10.0,19.0,-10.0));
#35=CARTESIAN_POINT('ISL_T2',(10.0,19.0,-10.0));
#36=CARTESIAN_POINT('ISL_T3',(10.0,19.0,10.0));
#37=CARTESIAN_POINT('ISL_T4',(-10.0,19.0,10.0));

/* 4 Corner Stepped Mounting Holes (Boss Pads) */
/* Corner 1: -X -Z */
#40=CARTESIAN_POINT('C1_1',(-60,15,-40));
#41=CARTESIAN_POINT('C1_2',(-48,15,-40));
#42=CARTESIAN_POINT('C1_3',(-48,15,-28));
#43=CARTESIAN_POINT('C1_4',(-60,15,-28));

/* Corner 2: +X -Z */
#44=CARTESIAN_POINT('C2_1',(48,15,-40));
#45=CARTESIAN_POINT('C2_2',(60,15,-40));
#46=CARTESIAN_POINT('C2_3',(60,15,-28));
#47=CARTESIAN_POINT('C2_4',(48,15,-28));

/* Corner 3: +X +Z */
#48=CARTESIAN_POINT('C3_1',(48,15,28));
#49=CARTESIAN_POINT('C3_2',(60,15,28));
#50=CARTESIAN_POINT('C3_3',(60,15,40));
#51=CARTESIAN_POINT('C3_4',(48,15,40));

/* Corner 4: -X +Z */
#52=CARTESIAN_POINT('C4_1',(-60,15,28));
#53=CARTESIAN_POINT('C4_2',(-48,15,28));
#54=CARTESIAN_POINT('C4_3',(-48,15,40));
#55=CARTESIAN_POINT('C4_4',(-60,15,40));

/* ==================== 2. B-REP POLYGON LOOPS ==================== */
/* Bottom Base Face */
#101=POLY_LOOP('LOOP_BOTTOM',(#10,#11,#12,#13));

/* 4 Outer Flank Faces */
#102=POLY_LOOP('LOOP_FRONT',(#10,#14,#17,#13));
#103=POLY_LOOP('LOOP_RIGHT',(#11,#15,#16,#12));
#104=POLY_LOOP('LOOP_BACK',(#12,#16,#15,#11));
#105=POLY_LOOP('LOOP_LEFT',(#13,#17,#14,#10));

/* Top Deck Surface (with central pocket aperture) */
#106=POLY_LOOP('LOOP_TOP_DECK_N',(#14,#15,#21,#20));
#107=POLY_LOOP('LOOP_TOP_DECK_S',(#23,#22,#16,#17));
#108=POLY_LOOP('LOOP_TOP_DECK_W',(#14,#20,#23,#17));
#109=POLY_LOOP('LOOP_TOP_DECK_E',(#21,#15,#16,#22));

/* Central Pocket Walls */
#110=POLY_LOOP('LOOP_PKT_WALL_NORTH',(#20,#21,#25,#24));
#111=POLY_LOOP('LOOP_PKT_WALL_EAST',(#21,#22,#26,#25));
#112=POLY_LOOP('LOOP_PKT_WALL_SOUTH',(#22,#23,#27,#26));
#113=POLY_LOOP('LOOP_PKT_WALL_WEST',(#23,#20,#24,#27));

/* Central Pocket Floor */
#114=POLY_LOOP('LOOP_PKT_FLOOR',(#24,#25,#26,#27));

/* Island Boss Faces */
#115=POLY_LOOP('LOOP_ISL_TOP',(#34,#35,#36,#37));
#116=POLY_LOOP('LOOP_ISL_WALL_N',(#30,#31,#35,#34));
#117=POLY_LOOP('LOOP_ISL_WALL_E',(#31,#32,#36,#35));
#118=POLY_LOOP('LOOP_ISL_WALL_S',(#32,#33,#37,#36));
#119=POLY_LOOP('LOOP_ISL_WALL_W',(#33,#30,#34,#37));

/* Corner Notch Stepdown Faces */
#120=POLY_LOOP('LOOP_C1_FLOOR',(#40,#41,#42,#43));
#121=POLY_LOOP('LOOP_C2_FLOOR',(#44,#45,#46,#47));
#122=POLY_LOOP('LOOP_C3_FLOOR',(#48,#49,#50,#51));
#123=POLY_LOOP('LOOP_C4_FLOOR',(#52,#53,#54,#55));

/* ==================== 3. FACE OUTER BOUNDS ==================== */
#201=FACE_OUTER_BOUND('FB1',#101,.T.);
#202=FACE_OUTER_BOUND('FB2',#102,.T.);
#203=FACE_OUTER_BOUND('FB3',#103,.T.);
#204=FACE_OUTER_BOUND('FB4',#104,.T.);
#205=FACE_OUTER_BOUND('FB5',#105,.T.);
#206=FACE_OUTER_BOUND('FB6',#106,.T.);
#207=FACE_OUTER_BOUND('FB7',#107,.T.);
#208=FACE_OUTER_BOUND('FB8',#108,.T.);
#209=FACE_OUTER_BOUND('FB9',#109,.T.);
#210=FACE_OUTER_BOUND('FB10',#110,.T.);
#211=FACE_OUTER_BOUND('FB11',#111,.T.);
#212=FACE_OUTER_BOUND('FB12',#112,.T.);
#213=FACE_OUTER_BOUND('FB13',#113,.T.);
#214=FACE_OUTER_BOUND('FB14',#114,.T.);
#215=FACE_OUTER_BOUND('FB15',#115,.T.);
#216=FACE_OUTER_BOUND('FB16',#116,.T.);
#217=FACE_OUTER_BOUND('FB17',#117,.T.);
#218=FACE_OUTER_BOUND('FB18',#118,.T.);
#219=FACE_OUTER_BOUND('FB19',#119,.T.);
#220=FACE_OUTER_BOUND('FB20',#120,.T.);
#221=FACE_OUTER_BOUND('FB21',#121,.T.);
#222=FACE_OUTER_BOUND('FB22',#122,.T.);
#223=FACE_OUTER_BOUND('FB23',#123,.T.);

/* ==================== 4. CLOSED SHELL & MANIFOLD SOLID ==================== */
#300=CLOSED_SHELL('BRACKET_MANIFOLD_SHELL',(#201,#202,#203,#204,#205,#206,#207,#208,#209,#210,#211,#212,#213,#214,#215,#216,#217,#218,#219,#220,#221,#222,#223));
#400=MANIFOLD_SOLID_BREP('CNC_AEROSPACE_FLANGE_BRACKET_SOLID',#300);
#500=SHAPE_DEFINITION_REPRESENTATION(#7,#400);

ENDSEC;
END-ISO-10303-21;